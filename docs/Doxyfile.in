PROJECT_NAME           = "CppTaskManager"
PROJECT_NUMBER         = "1.0.0"
OUTPUT_DIRECTORY       = ./docs/generated
INPUT                  = ./include ./src ./README.md
RECURSIVE              = YES
GENERATE_HTML          = YES
